#!/usr/bin/env bash
set -euo pipefail

_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

_usage() {
  cat <<'EOF'
Usage: pyjenkinsapi-lint [rigor lint args...]

Run rigor lint with the repo-local Python backend mapping.
EOF
}

_warn() {
  printf 'WARN: %s\n' "$*" >&2
}

_repo_root_path="$(_repo_root || true)"
[[ -n "$_repo_root_path" ]] || {
  _warn "Not inside a git repository; falling back to current directory"
  _repo_root_path="$(pwd)"
}

cd "$_repo_root_path"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  _usage
  exit 0
fi

backend_cmd="${PYJENKINSAPI_LINT_BACKEND_CMD:-ruff}"
export RIGOR_LINT_BACKENDS="${PYJENKINSAPI_LINT_BACKENDS:-py:${backend_cmd}}"

exec "$_repo_root_path/tools/rigor-cli/bin/rigor" lint "$@"
