#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null || true)"

_usage() {
  cat <<'EOF'
Usage: pyjenkinsapi-azure-upload [options]

Upload the local pyjenkinsapi repository to Azure DevOps and keep a git remote
in sync.

Options:
  --org URL            Azure DevOps organization URL or name
  --project NAME        Azure DevOps project
  --repo NAME           Azure DevOps repository name (default: repo basename)
  --remote-name NAME    Local git remote name to create/update (default: azure)
  --push-mode MODE      current | all | mirror (default: all)
  --auto-detect         Infer org/project from an Azure remote or az defaults
  --create-repo         Create the Azure repo if it is missing (default)
  --no-create-repo      Do not create the Azure repo if it is missing
  --install-extension   Install or update the azure-devops Azure CLI extension
  --dry-run             Print commands without running them
  -h, --help            Show this help text
EOF
}

_warn() {
  printf 'WARN: %s\n' "$*" >&2
}

_err() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ -n "$repo_root" ]] || _err "Run from inside a git repository"
if [[ ! -r "$repo_root/tools/rigor-cli/scripts/lib/foundation/scripts/lib/system.sh" ]]; then
  _err "Missing vendored lib-foundation helpers under tools/rigor-cli"
fi

# shellcheck source=/dev/null
source "$repo_root/tools/rigor-cli/scripts/lib/foundation/scripts/lib/system.sh"

azure_cache_dir=""
cleanup_azure_cache=0
if [[ -n "${PYJENKINSAPI_AZURE_CACHE_DIR:-}" ]]; then
  azure_cache_dir="$PYJENKINSAPI_AZURE_CACHE_DIR"
else
  azure_cache_dir="${TMPDIR:-/tmp}/pyjenkinsapi-azure-devops.${$}.${RANDOM}"
  cleanup_azure_cache=1
fi
export AZURE_DEVOPS_CACHE_DIR="$azure_cache_dir"

cleanup() {
  if (( cleanup_azure_cache )) && [[ -d "$azure_cache_dir" ]]; then
    rm -rf "$azure_cache_dir"
  fi
}
trap cleanup EXIT

org="${PYJENKINSAPI_AZURE_ORG:-${AZURE_DEVOPS_ORG:-}}"
project="${PYJENKINSAPI_AZURE_PROJECT:-${AZURE_DEVOPS_PROJECT:-}}"
repo_name="${PYJENKINSAPI_AZURE_REPO:-${repo_root##*/}}"
remote_name="${PYJENKINSAPI_AZURE_REMOTE_NAME:-azure}"
push_mode="${PYJENKINSAPI_AZURE_PUSH_MODE:-all}"
create_repo="${PYJENKINSAPI_AZURE_CREATE_REPO:-1}"
install_extension="${PYJENKINSAPI_AZURE_INSTALL_EXTENSION:-0}"
auto_detect="${PYJENKINSAPI_AZURE_AUTO_DETECT:-0}"
dry_run=0

_detect_from_remote_url() {
  local remote_url="$1"
  local detected_org=""
  local detected_project=""

  if [[ "$remote_url" =~ ^https?://dev\.azure\.com/([^/]+)/([^/]+)/_git/[^/]+/?$ ]]; then
    detected_org="${BASH_REMATCH[1]}"
    detected_project="${BASH_REMATCH[2]}"
  elif [[ "$remote_url" =~ ^https?://([^@/]+)@dev\.azure\.com/([^/]+)/([^/]+)/_git/[^/]+/?$ ]]; then
    detected_org="${BASH_REMATCH[2]}"
    detected_project="${BASH_REMATCH[3]}"
  elif [[ "$remote_url" =~ ^ssh://[^@]+@ssh\.dev\.azure\.com/v3/([^/]+)/([^/]+)/[^/]+/?$ ]]; then
    detected_org="${BASH_REMATCH[1]}"
    detected_project="${BASH_REMATCH[2]}"
  elif [[ "$remote_url" =~ ^git@ssh\.dev\.azure\.com:v3/([^/]+)/([^/]+)/[^/]+/?$ ]]; then
    detected_org="${BASH_REMATCH[1]}"
    detected_project="${BASH_REMATCH[2]}"
  fi

  if [[ -n "$detected_org" && -n "$detected_project" ]]; then
    printf '%s\n%s\n' "$detected_org" "$detected_project"
    return 0
  fi

  return 1
}

_detect_azure_defaults() {
  local config_output
  config_output="$(az devops configure -l --only-show-errors 2>/dev/null || true)"
  local detected_org=""
  local detected_project=""

  if [[ "$config_output" =~ Organization[[:space:]]*=[[:space:]]*(.+)$ ]]; then
    detected_org="${BASH_REMATCH[1]}"
  fi
  if [[ "$config_output" =~ Project[[:space:]]*=[[:space:]]*(.+)$ ]]; then
    detected_project="${BASH_REMATCH[1]}"
  fi

  detected_org="$(printf '%s' "$detected_org" | sed 's/[[:space:]]*$//')"
  detected_project="$(printf '%s' "$detected_project" | sed 's/[[:space:]]*$//')"

  if [[ -n "$detected_org" && -n "$detected_project" ]]; then
    printf '%s\n%s\n' "$detected_org" "$detected_project"
    return 0
  fi

  return 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --org)
      shift
      [[ $# -gt 0 ]] || _err "--org requires a value"
      org="$1"
      ;;
    --project)
      shift
      [[ $# -gt 0 ]] || _err "--project requires a value"
      project="$1"
      ;;
    --repo)
      shift
      [[ $# -gt 0 ]] || _err "--repo requires a value"
      repo_name="$1"
      ;;
    --remote-name)
      shift
      [[ $# -gt 0 ]] || _err "--remote-name requires a value"
      remote_name="$1"
      ;;
    --push-mode)
      shift
      [[ $# -gt 0 ]] || _err "--push-mode requires a value"
      push_mode="$1"
      ;;
    --auto-detect)
      auto_detect=1
      ;;
    --create-repo)
      create_repo=1
      ;;
    --no-create-repo)
      create_repo=0
      ;;
    --install-extension)
      install_extension=1
      ;;
    --dry-run)
      dry_run=1
      ;;
    -h|--help)
      _usage
      exit 0
      ;;
    *)
      _err "Unknown argument: $1"
      ;;
  esac
  shift
done

if [[ "$auto_detect" -eq 1 ]]; then
  if [[ -z "$org" || -z "$project" ]]; then
    if git remote get-url "$remote_name" >/dev/null 2>&1; then
      remote_guess="$(git remote get-url "$remote_name")"
      if detected_values="$(_detect_from_remote_url "$remote_guess" 2>/dev/null)"; then
        org="${org:-$(sed -n '1p' <<<"$detected_values")}"
        project="${project:-$(sed -n '2p' <<<"$detected_values")}"
      fi
    fi
  fi

  if [[ -z "$org" || -z "$project" ]]; then
    if detected_values="$(_detect_azure_defaults 2>/dev/null)"; then
      org="${org:-$(sed -n '1p' <<<"$detected_values")}"
      project="${project:-$(sed -n '2p' <<<"$detected_values")}"
    fi
  fi
fi

if [[ -z "$org" || -z "$project" ]]; then
  _err "--org and --project are required unless --auto-detect can infer both values"
fi
[[ -n "$repo_name" ]] || _err "--repo must not be empty"
[[ -n "$remote_name" ]] || _err "--remote-name must not be empty"

case "$push_mode" in
  current|all|mirror)
    ;;
  *)
    _err "Unsupported push mode: $push_mode"
    ;;
esac

case "$org" in
  http://*|https://*)
    org_url="${org%/}"
    ;;
  *)
    org_url="https://dev.azure.com/${org%/}"
    ;;
esac

remote_url="${org_url%/}/${project}/_git/${repo_name}"

run_cmd() {
  if (( dry_run )); then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  _run_command --quiet -- "$@"
}

if ! command -v git >/dev/null 2>&1; then
  _err "git is required"
fi
if ! command -v az >/dev/null 2>&1; then
  _err "az is required"
fi

if ! az extension show --name azure-devops --only-show-errors -o none >/dev/null 2>&1; then
  if [[ "$install_extension" -eq 1 ]]; then
    run_cmd az extension add --name azure-devops --yes --only-show-errors
  else
    _err "Azure CLI extension azure-devops is missing. Re-run with --install-extension or install it manually."
  fi
fi

repo_exists=0
if az repos show --repository "$repo_name" --organization "$org_url" --project "$project" --only-show-errors -o none >/dev/null 2>&1; then
  repo_exists=1
fi

if [[ "$repo_exists" -eq 0 ]]; then
  if [[ "$create_repo" -eq 1 ]]; then
    _warn "Azure repo '${repo_name}' does not exist; creating it"
    run_cmd az repos create --name "$repo_name" --organization "$org_url" --project "$project" --only-show-errors -o none
  else
    _err "Azure repo '${repo_name}' does not exist and --no-create-repo was set"
  fi
fi

if git remote get-url "$remote_name" >/dev/null 2>&1; then
  run_cmd git remote set-url "$remote_name" "$remote_url"
else
  run_cmd git remote add "$remote_name" "$remote_url"
fi

case "$push_mode" in
  current)
    branch="$(git branch --show-current)"
    [[ -n "$branch" ]] || _err "Detached HEAD; use --push-mode all or --push-mode mirror"
    run_cmd git push "$remote_name" "$branch:$branch"
    ;;
  all)
    run_cmd git push "$remote_name" --all
    run_cmd git push "$remote_name" --tags
    ;;
  mirror)
    run_cmd git push "$remote_name" --mirror
    ;;
esac

printf 'Uploaded %s to %s via remote %s (%s)\n' "$repo_name" "$org_url" "$remote_name" "$push_mode"
